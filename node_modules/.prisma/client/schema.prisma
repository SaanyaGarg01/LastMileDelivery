// Prisma schema for Last-Mile Delivery Tracker (SQLite Configuration for 100% Reliable Execution)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         String   @default("CUSTOMER") // CUSTOMER, AGENT, ADMIN
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agentProfile     Agent?
  customerOrders   Order[]           @relation("CustomerOrders")
  notifications    Notification[]
  supportTickets   SupportTicket[]
  supportResponses SupportResponse[]

  @@index([email])
}

model Agent {
  id                    String    @id @default(uuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                String    @default("AVAILABLE") // AVAILABLE, BUSY, OFFLINE
  currentLat            Float     @default(28.6139)
  currentLng            Float     @default(77.2090)
  vehicleType           String    @default("BIKE")
  maxCapacity           Int       @default(5)
  activeOrderId         String?
  lastLocationUpdatedAt DateTime?
  gpsAccuracy           Float?    @default(10.0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  assignedOrders Order[]           @relation("AgentOrders")
  assignments    OrderAssignment[]
  locations      AgentLocation[]
  pods           ProofOfDelivery[]
  earnings       AgentEarning[]

  @@index([status])
}

model Zone {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  areas        ZoneArea[]
  pickupOrders Order[]    @relation("PickupZone")
  dropOrders   Order[]    @relation("DropZone")
}

model ZoneArea {
  id        String   @id @default(uuid())
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  areaName  String
  pincode   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pincode])
  @@index([zoneId])
}

model RateCard {
  id           String   @id @default(uuid())
  orderType    String // B2B, B2C
  zoneType     String // INTRA, INTER
  weightFrom   Float // kg
  weightTo     Float // kg
  rate         Float // currency amount
  codSurcharge Float    @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id          String @id @default(uuid())
  orderNumber String @unique
  customerId  String
  customer    User   @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)

  pickupAddress String
  pickupPincode String
  pickupZoneId  String
  pickupZone    Zone   @relation("PickupZone", fields: [pickupZoneId], references: [id])
  pickupLat     Float?
  pickupLng     Float?

  dropAddress String
  dropPincode String
  dropZoneId  String
  dropZone    Zone   @relation("DropZone", fields: [dropZoneId], references: [id])
  dropLat     Float?
  dropLng     Float?

  length           Float
  breadth          Float
  height           Float
  actualWeight     Float
  volumetricWeight Float
  chargeableWeight Float

  orderType   String // B2B, B2C
  paymentType String // PREPAID, COD
  zoneType    String // INTRA, INTER

  deliveryCharge Float
  codSurcharge   Float
  totalAmount    Float

  status String @default("CREATED") // CREATED, ASSIGNED, PICKED_UP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, FAILED, RESCHEDULED

  assignedAgentId String?
  assignedAgent   Agent?  @relation("AgentOrders", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  scheduledDate   DateTime?
  rescheduleCount Int       @default(0)

  createdBy             String?
  createdByRole         String  @default("CUSTOMER") // CUSTOMER, ADMIN
  assignmentType        String  @default("AUTO") // MANUAL, AUTO
  deliveryAttemptNumber Int     @default(1)
  failureNotes          String?

  deliverySlotId       String?
  deliverySlotLabel    String?
  promisedDeliveryDate DateTime?
  slaDeadline          DateTime?
  slaStatus            String    @default("ON_TRACK")
  actualDeliveryAt     DateTime?

  paymentStatus      String    @default("PENDING")
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledBy        String?

  deliveryOtp          String?
  deliveryOtpExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       OrderItem[]
  rating      DeliveryRating?
  chats       CustomerChat[]
  assignments OrderAssignment[]
  tracking    OrderTracking[]
  reschedules Reschedule[]
  pod         ProofOfDelivery?
  earnings    AgentEarning[]
  tickets     SupportTicket[]
  locations   AgentLocation[]

  @@index([status])
  @@index([customerId])
  @@index([assignedAgentId])
  @@index([pickupZoneId])
  @@index([dropZoneId])
  @@index([slaStatus])
}

model OrderAssignment {
  id            String    @id @default(uuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  agentId       String
  agent         Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  assignedBy    String    @default("SYSTEM")
  attemptNumber Int       @default(1)
  status        String    @default("ACTIVE")
  assignedAt    DateTime  @default(now())
  unassignedAt  DateTime?

  @@index([orderId])
  @@index([agentId])
}

model OrderTracking {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  actorId   String
  actorRole String
  remarks   String?
  timestamp DateTime @default(now())

  @@index([orderId])
}

model Reschedule {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousAgentId  String?
  newScheduledDate DateTime
  reason           String?
  rescheduledBy    String
  createdAt        DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String
  actorName     String?
  actorRole     String
  action        String
  entityType    String
  entityId      String?
  previousValue String?
  newValue      String?
  details       String?
  timestamp     DateTime @default(now())

  @@index([actorId])
  @@index([entityType])
  @@index([timestamp])
}

model AgentLocation {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  latitude  Float
  longitude Float
  accuracy  Float?
  timestamp DateTime @default(now())

  @@index([agentId])
  @@index([orderId])
  @@index([timestamp])
}

model DeliverySlot {
  id          String   @id @default(uuid())
  startTime   String
  endTime     String
  label       String
  maxCapacity Int      @default(50)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProofOfDelivery {
  id                 String   @id @default(uuid())
  orderId            String   @unique
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  agentId            String
  agent              Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  recipientName      String
  verificationMethod String   @default("OTP")
  verifiedAt         DateTime @default(now())
  notes              String?
}

model AgentEarning {
  id                String   @id @default(uuid())
  agentId           String
  agent             Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  basePayout        Float
  distanceIncentive Float    @default(0)
  deliveryBonus     Float    @default(0)
  totalEarning      Float
  settlementStatus  String   @default("PENDING")
  createdAt         DateTime @default(now())

  @@index([agentId])
  @@index([settlementStatus])
}

model SupportTicket {
  id              String   @id @default(uuid())
  ticketNumber    String   @unique
  customerId      String
  customer        User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId         String?
  order           Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  category        String
  description     String
  priority        String   @default("MEDIUM")
  status          String   @default("OPEN")
  assignedAdminId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  responses SupportResponse[]

  @@index([customerId])
  @@index([status])
}

model SupportResponse {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderRole String
  message    String
  createdAt  DateTime      @default(now())

  @@index([ticketId])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

model AutoPilotLog {
  id         String   @id @default(uuid())
  mode       String   @default("RECOMMENDATION_ONLY")
  eventTitle String
  details    String
  timestamp  DateTime @default(now())

  @@index([timestamp])
}

model PublicTrackingToken {
  id        String    @id @default(uuid())
  orderId   String    @unique
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}

model CustomerAddress {
  id           String   @id @default(uuid())
  userId       String
  label        String   @default("Home")
  addressLine  String
  city         String   @default("Mumbai")
  state        String   @default("Maharashtra")
  pincode      String
  landmark     String?
  contactName  String   @default("Customer")
  contactPhone String   @default("9876543210")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name           String
  category       String
  quantity       Int      @default(1)
  declaredValue  Float
  description    String?
  imageUrl       String?
  isFragile      Boolean  @default(false)
  handleWithCare Boolean  @default(false)
  keepUpright    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orderId])
}

model DeliveryRating {
  id                String   @id @default(uuid())
  orderId           String   @unique
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId        String
  agentId           String
  rating            Int
  fastDelivery      Boolean  @default(false)
  professionalAgent Boolean  @default(false)
  easyTracking      Boolean  @default(false)
  goodCommunication Boolean  @default(false)
  feedback          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CustomerChat {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId   String
  senderRole String
  message    String
  timestamp  DateTime @default(now())

  @@index([orderId])
}

model NotificationLog {
  id            String   @id @default(uuid())
  orderId       String?
  userId        String?
  channel       String
  type          String
  status        String   @default("SENT")
  provider      String   @default("INTERNAL")
  message       String
  sentAt        DateTime @default(now())
  failureReason String?
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([userId])
}
