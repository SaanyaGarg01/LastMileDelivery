{
  "name": "last-mile-delivery-tracker",
  "version": "1.0.0",
  "description": "Last-Mile Delivery Tracker - Production logistics platform",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev:backend": "node src/server.js",
    "dev:frontend": "npm run dev --prefix client",
    "dev": "node src/server.js",
    "build": "cd client && npm install --legacy-peer-deps && npm run build && cd .. && npx prisma db push && npx prisma generate && node scratch/seed_15_agents.js",
    "prisma:generate": "prisma generate",
    "prisma:db:push": "prisma db push",
    "seed": "node scratch/seed_15_agents.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.19.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
